# AI Code Insights API runtime config
#
# MYSQL_HOST 怎么填：
# 1. 如果 MySQL 跑在你这台 Mac 宿主机上，Docker 容器里应写 `host.docker.internal`
# 2. 如果 MySQL 跑在远程服务器上，写远程服务器的 IP 或域名，例如 `10.0.0.12`
# 3. 不要在 Docker 场景里写 `127.0.0.1` 或 `localhost`，那会指向 API 容器自己，不是宿主机

# MySQL 主机地址
MYSQL_HOST=host.docker.internal

# MySQL 端口，默认 3306
MYSQL_PORT=3306

# 业务数据库名
# 启动时如果库不存在，服务会自动尝试创建这个库
MYSQL_DATABASE=ai_code_insights

# MySQL 登录用户名
MYSQL_USER=ai_code

# MySQL 登录密码
MYSQL_PASSWORD=change-me

# MySQL 字符集，建议保持 utf8mb4
MYSQL_CHARSET=utf8mb4

# 用于加密存储 AI provider 的 apiKey 等敏感配置
# 生产环境请替换成你自己的随机密钥
APP_SETTINGS_ENCRYPTION_KEY=8j9i6qbIeLlqrvHqYgfdJq0arIpFCmInjY14IjCI-68=

# 启动种子版本号
# 仅用于管理初始化元数据；需要刷新 bootstrap 元数据时再改
BOOTSTRAP_SEED_VERSION=2026-03-07.1

# 可选：预置 AI 设置 JSON
# 留空表示不预置任何 AI provider
# 如果填写，格式必须符合 AISettingsPayload，例如：
# {"defaultProfile":"internal-openai","profiles":[{"provider":"openai-compatible","name":"internal-openai","baseUrl":"https://llm.example.com/v1","apiKey":"replace-me","model":"gpt-4.1-mini","temperature":0.2,"maxTokens":1200,"enabled":true}]}
SEED_AI_SETTINGS_JSON=

# API 对外基地址
# 主要用于前端/部署场景里的地址展示或调用配置
API_BASE_URL=http://localhost:18080
